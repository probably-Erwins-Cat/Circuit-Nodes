# Shared design inputs belong in Git: .kicad_pcb, .kicad_sch, .kicad_pro,
# .kicad_dru, custom libraries/models, and populated library tables.
# Keep released manufacturing ZIPs and catalog PNGs too.

# KiCad local editor state, caches, and open-project locks.
# These are regenerated and do not describe the shared circuit design.
*.kicad_prl
fp-info-cache
~*.lck
*.kicad_pcb.lck
*.kicad_sch.lck
*.kicad_pro.lck

# KiCad recovery snapshots and autosaves: retain locally, exclude from Git.
.history/
*-backups/
**/backup/
**/backups/
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak
_autosave-*
*-save.pro
*-save.kicad_pcb
*-save.kicad_sch

# Local KiCad plugin preferences. Geometry is saved in the PCB itself.
*.round-tracks-config
fabrication-toolkit-options.json

# Reproducible fabrication-toolkit exports, separate from release ZIPs.
# Scope CSV/XML exclusions to production folders so unrelated data stays visible.
**/production/*.csv
**/production/*.xml
**/production/*.ipc

# Generated netlists and autorouter exchange/session files.
*.net
*.dsn
*.ses

# FreeCAD recovery files; preserve the editable .FCStd source and STEP/STL exports.
*.FCBak
*.FCStd[0-9]*

# General application/editor recovery files.
*.000
*.bak
*.bck
*.tmp
*~

# Jekyll generated website and caches; source Markdown and assets stay tracked.
/_site/
/.jekyll-cache/
docs/.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Local server state and application logs.
/jekyll-local.pid
*.log

# Machine-specific editor settings and OS metadata.
.vscode/
.idea/
.DS_Store
Thumbs.db

# Renderer scratch files are excluded by scripts/catalog-render/.gitignore.
