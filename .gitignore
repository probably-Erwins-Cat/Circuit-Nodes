# Shared design inputs and published assets stay in Git:
# .kicad_pcb, .kicad_sch, .kicad_pro, library tables/custom libraries,
# 3D models, README files, TOP/BOTTOM PNGs, and production ZIPs.

# KiCad machine-local project state and rebuildable footprint cache
*.kicad_prl
fp-info-cache

# KiCad locks and recovery/autosave files
~*.lck
*.kicad_pcb.lck
*.kicad_sch.lck
_autosave-*
*-save.pro
*-save.kicad_pcb
*.kicad_pcb-bak
*.kicad_sch-bak
*.sch-bak

# KiCad/editor history and backup directories (including ZIP snapshots)
.history/
*-backups/
backup/
backups/

# Local plugin preferences; shared rendering configuration stays tracked
*.round-tracks-config
fabrication-toolkit-options.json

# Rebuildable fabrication-toolkit intermediate files; keep production ZIPs
/puzzle-pieces/**/production/*.csv
/puzzle-pieces/**/production/*.xml
/puzzle-pieces/**/production/*.ipc

# Exported netlists and autorouter interchange/session files
*.net
*.dsn
*.ses

# General temporary/backup files and FreeCAD backup variants
*.000
*.bak
*.bck
*.tmp
*~
*.FCBak
*.FCStd1

# Jekyll generated site and caches
/_site/
/.jekyll-cache/
docs/.jekyll-cache/
.jekyll-metadata
.sass-cache/

# Local process logs
*.log

# OS files and personal editor settings
.DS_Store
Thumbs.db
.vscode/
.idea/
